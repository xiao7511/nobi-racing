  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Native OIDC authorization code with PKCE; validate issuer, audience, expiry and permissions"
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-nobi_session",
        "description": "Web BFF session; Secure, HttpOnly, Path=/, SameSite=Lax, CSRF protection on writes"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "AUTH_REQUIRED",
              "AUTH_FORBIDDEN",
              "RESOURCE_NOT_FOUND",
              "VERSION_CONFLICT",
              "SOURCE_NOT_AUTHORIZED",
              "SOURCE_UNAVAILABLE",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ]
          },
          "traceId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "phase",
          "dataMode"
        ],
        "properties": {
          "status": {
            "const": "foundation"
          },
          "phase": {
            "const": "0"
          },
          "dataMode": {
            "const": "mock"
          }
        }
      },
      "Provenance": {
        "type": "object",
        "required": [
          "sourceId",
          "mode",
          "fetchedAt",
          "attribution"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "licensed"
            ]
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "attribution": {
            "type": "string"
          },
          "stale": {
            "type": "boolean",
            "description": "Only true when stale display is explicitly licensed"
          }
        }
      },
      "Race": {
        "type": "object",
        "required": [
          "id",
          "name",
          "startsAt",
          "timeZone",
          "status",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string",
            "description": "IANA timezone, e.g. Asia/Shanghai"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "cancelled"
            ]
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        }
      },
      "Article": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "canonicalUrl",
          "locale",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          },
          "canonicalUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "zh-CN"
            ]
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        }
      },
      "Standing": {
        "type": "object",
        "required": [
          "id",
          "subjectId",
          "kind",
          "position",
          "points",
          "capturedAt",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Snapshot UUID"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "driver",
              "team"
            ]
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "points": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]{1,3})?$",
            "description": "Decimal string avoids binary floating point loss"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        }
      },
      "Preferences": {
        "type": "object",
        "required": [
          "locale",
          "timeZone"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "zh-CN"
            ]
          },
          "timeZone": {
            "type": "string",
            "maxLength": 100,
            "description": "Server must validate against IANA TZ database"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "preferences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          }
        }
      },
      "Source": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mode",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "licensed"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "attribution": {
            "type": "string"
          }
        }
      },
      "Grant": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "status",
          "validFrom",
          "validUntil",
          "capabilities",
          "territories",
          "evidenceRef",
          "revision",
          "createdBy",
          "retentionDays"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "revoked"
            ]
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "territories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "minItems": 1
          },
          "evidenceRef": {
            "type": "string",
            "description": "Restricted internal evidence reference; never a credential-bearing URL"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          },
          "approvedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "retentionDays": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "RacePage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Race"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ArticlePage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Article"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "StandingPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Standing"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SourcePage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
