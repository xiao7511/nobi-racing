{
  "name": "nobi-racing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=10.34.8 <11"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "check:baseline": "node scripts/check-baseline.mjs",
    "test:baseline": "node --test tests/baseline.test.mjs",
    "check": "pnpm check:baseline && pnpm test:baseline && pnpm typecheck && pnpm test:unit && pnpm build && pnpm check:api",
    "typecheck": "pnpm -r --if-present typecheck && pnpm --filter @nobi/fan exec vue-tsc -p ../../tsconfig.tools.json",
    "test:unit": "vitest run",
    "build": "pnpm -r --if-present build",
    "test:e2e": "playwright test",
    "test:backend": "mvn -f services/racing-api/pom.xml verify",
    "test:db": "mvn -f services/racing-api/pom.xml -Pdatabase-it verify",
    "check:api": "redocly lint packages/contracts/openapi.json",
    "dev:fan": "pnpm --filter @nobi/fan dev",
    "dev:admin": "pnpm --filter @nobi/admin dev",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm test:baseline && pnpm test:unit",
    "check:phase1": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts --project=chromium",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "api:phase2:update": "node scripts/update-phase2-openapi.mjs",
    "api:phase2:check": "node scripts/update-phase2-openapi.mjs --check",
    "test:phase2:contracts": "node scripts/check-phase2-contracts.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "api:client:generate": "node scripts/generate-api-client.mjs",
    "api:client:check": "node scripts/generate-api-client.mjs --check",
    "test:e2e:fixture": "playwright test --grep-invert \"capture bilingual\"",
    "verify:phase3": "node scripts/verify-phase3.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@redocly/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "js-yaml": "4.3.2",
    "jsdom": "^27.0.0",
    "pinia": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "~7.3.0",
    "vitest": "^4.0.0",
    "vue": "~3.5.44",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.6.0"
  }
}
